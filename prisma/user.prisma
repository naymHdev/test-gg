model User {
    id           String        @id @default(cuid())
    username     String        @unique
    email        String        @unique
    passwordHash String
    role         Role          @default(User)
    status       AccountStatus @default(Active)

    region          Region
    accountLanguage Language // immutable after registration
    uiLanguage      Language @default(en)

    isPremium      Boolean @default(false)
    isRiotVerified Boolean @default(false)
    riotAccount    Json?
    riotPuuid      String? @unique

    stripeCustomerId String? @unique

    twoFactorEnabled          Boolean @default(true)
    emailNotifications        Boolean @default(true)
    newMessageNotifications   Boolean @default(true)
    systemUpdateNotifications Boolean @default(true)

    warningCount Int       @default(0)
    timeoutUntil DateTime?

    banReason  String?
    banDetails String?
    bannedById String?
    bannedBy   User?     @relation("BannedByAdmin", fields: [bannedById], references: [id])
    bannedAt   DateTime?

    agreedToTerms   Boolean @default(false)
    agreedToPrivacy Boolean @default(false)

    lastActiveAt DateTime?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    // relations
    profile            Profile?
    wallet             Wallet?
    userPoints         UserPoints?
    subscription       Subscription?
    permissions        UserPermission[] @relation("UserPermissions")
    grantedPermissions UserPermission[] @relation("GrantedByAdmin")
    refreshTokens      RefreshToken[]
    bannedUsers        User[]           @relation("BannedByAdmin")

    posts      Post[]
    mediaPosts MediaPost[]

    createdTournaments            Tournament[]                   @relation("TournamentCreator")
    approvedTournaments           Tournament[]                   @relation("TournamentApprover")
    tournamentPaymentTransactions TournamentPaymentTransaction[] @relation("TournamentPaymentCreator")
    capturedTeams                 Team[]                         @relation("TeamCaptain")
    teamMemberships               TeamMember[]
    declaredMatches               Match[]                        @relation("MatchDeclaredBy")

    createdChallenges    Challenge[]
    challengeEnrollments ChallengeEnrollment[]
    createdRewards       Reward[]
    rewardPurchases      RewardPurchase[]

    friendsInitiated Friend[]  @relation("FriendInitiator")
    friendsReceived  Friend[]  @relation("FriendTarget")
    messagesSent     Message[] @relation("MessageSender")
    messagesReceived Message[] @relation("MessageReceiver")

    supportConversations SupportConversation[] @relation("SupportUser")
    closedConversations  SupportConversation[] @relation("SupportClosedBy")
    supportMessages      SupportMessage[]

    reportsFiled    Report[] @relation("Reporter")
    reportsReceived Report[] @relation("ReportedUser")
    reportsResolved Report[] @relation("ReportResolver")

    activityLogs ActivityLog[]

    notifications Notification[]

    deviceTokens DeviceToken[]

    mediaReactions        MediaReaction[]
    mediaCommentReactions MediaCommentReaction[]
    mediaComments         MediaComment[]

    postReactions        PostReaction[]        @relation("PostReactionUser")
    postComments         PostComment[]         @relation("PostCommentAuthor")
    postCommentReplyTo   PostComment[]         @relation("PostCommentReplyTo")
    postCommentReactions PostCommentReaction[] @relation("PostCommentReactionUser")
    voiceChannels        VoiceChannel[]        @relation("VoiceChannelOwner")
    voiceChannelBans     VoiceChannelBan[]     @relation("VoiceChannelBannedUser")
    waitingRoomRequests  WaitingRoomRequest[]  @relation("VoiceChannelWaitingUser")
    channelMessages      ChannelMessage[]      @relation("ChannelMessageSender")
    reviewedWithdrawals  WithdrawalRequest[]   @relation("WithdrawalReviewer")
    paymentMethods       PaymentMethod[]
    withdrawalRequests   WithdrawalRequest[]

    reviewsGiven    PlayerReview[] @relation("ReviewsGiven")
    reviewsReceived PlayerReview[] @relation("ReviewsReceived")

    @@index([region, accountLanguage])
    @@map("users")
}

model Profile {
    userId String @id
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    avatarUrl       String?
    bannerUrl       String?
    background      String?
    borderStyle     String?
    nameColor       String?
    postBackground  String?
    postBorderStyle String?
    bio             String?

    rank               String?
    lp                 Int?
    tournamentEarnings Decimal @default(0) @db.Decimal(10, 2)

    updatedAt DateTime @updatedAt

    @@map("profiles")
}

// Granular moderator permissions (Owner-assigned)
model UserPermission {
    userId String
    user   User   @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)

    permission Permission

    grantedById String
    grantedBy   User     @relation("GrantedByAdmin", fields: [grantedById], references: [id])
    grantedAt   DateTime @default(now())

    @@id([userId, permission])
    @@map("user_permissions")
}

model RefreshToken {
    id     String @id @default(cuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    token     String    @unique
    expiresAt DateTime
    createdAt DateTime  @default(now())
    revokedAt DateTime?

    ipAddress  String?
    userAgent  String? // raw UA string, kept for audit/debug
    deviceName String? // parsed e.g. "Chrome on Windows", "iPhone App"
    deviceType String? // 'mobile' | 'desktop' | 'tablet'
    lastUsedAt DateTime @default(now()) // bumped on every /refresh call

    @@index([userId])
    @@map("refresh_tokens")
}

model DeviceToken {
    id     String @id @default(cuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    token    String  @unique
    platform String? // 'ios' | 'android' | 'web'

    createdAt  DateTime @default(now())
    lastSeenAt DateTime @updatedAt

    @@index([userId])
    @@map("device_tokens")
}

model PlayerReview {
    id String @id @default(cuid())

    // who give review
    reviewerId String
    reviewer   User   @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)

    // Who should be given a review?
    reviewedUserId String
    reviewedUser   User   @relation("ReviewsReceived", fields: [reviewedUserId], references: [id], onDelete: Cascade)

    // 1 - 5
    rating Int
    review String? @db.VarChar(500)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([reviewerId, reviewedUserId])
    @@index([reviewedUserId, rating])
    @@index([reviewerId])
    @@index([reviewedUserId, createdAt])
    @@map("player_reviews")
}
