model Tournament {
  id        String @id @default(cuid())
  creatorId String
  creator   User   @relation("TournamentCreator", fields: [creatorId], references: [id])

  name      String           @db.VarChar(200)
  region    Region
  gameMode  String           @db.VarChar(50)
  format    TournamentFormat
  maxTeams  Int
  entryFee  Decimal          @default(0) @db.Decimal(10, 2)
  prizePool Decimal          @default(0) @db.Decimal(10, 2)
  startDate DateTime
  status    TournamentStatus @default(Pending)

  logo  String?
  cover String?
  image String?

  approvedById String?
  approvedBy   User?     @relation("TournamentApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  teams   Team[]
  matches Match[]
  paymentTransaction TournamentPaymentTransaction?

  createdAt DateTime @default(now())

  @@index([status, region])
  @@map("tournaments")
}

model TournamentCheckout {
  id                      String   @id @default(cuid())
  creatorId               String
  amount                  Decimal  @db.Decimal(10, 2)
  payload                 Json
  stripeCheckoutSessionId String?  @unique
  tournamentId            String?  @unique
  completedAt             DateTime?
  createdAt               DateTime @default(now())

  @@index([creatorId])
  @@map("tournament_checkouts")
}

model TournamentPaymentTransaction {
  id                      String     @id @default(cuid())
  tournamentId            String     @unique
  tournament              Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  creatorId               String
  creator                 User       @relation("TournamentPaymentCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  amount                  Decimal    @db.Decimal(10, 2)
  currency                String     @default("EUR") @db.VarChar(3)
  stripeCheckoutSessionId String     @unique
  stripePaymentIntentId   String?    @unique
  paidAt                  DateTime
  createdAt               DateTime   @default(now())

  @@index([creatorId])
  @@index([paidAt])
  @@map("tournament_payment_transactions")
}

model Team {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)

  captainId String
  captain   User   @relation("TeamCaptain", fields: [captainId], references: [id])

  members TeamMember[]

  matchesAsA Match[] @relation("MatchTeamA")
  matchesAsB Match[] @relation("MatchTeamB")
  matchesWon Match[] @relation("MatchWinner")

  createdAt DateTime @default(now())

  @@unique([tournamentId, captainId])
  @@map("teams")
}

model TeamMember {
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  tournamentId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     TeamMemberRole @default(Member)
  joinedAt DateTime       @default(now())

  @@id([teamId, userId])
  @@unique([tournamentId, userId])
  @@map("team_members")
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  teamAId String
  teamA   Team   @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamBId String
  teamB   Team   @relation("MatchTeamB", fields: [teamBId], references: [id])

  winnerId String?
  winner   Team?   @relation("MatchWinner", fields: [winnerId], references: [id])

  round      Int
  matchIndex Int

  scheduledAt DateTime
  status      MatchStatus @default(Scheduled)

  declaredById String?
  declaredBy   User?     @relation("MatchDeclaredBy", fields: [declaredById], references: [id])
  declaredAt   DateTime?

  createdAt DateTime @default(now())

  @@index([tournamentId, round])
  @@index([teamAId, scheduledAt])
  @@index([teamBId, scheduledAt])
  @@map("matches")
}
